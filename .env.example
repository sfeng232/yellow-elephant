# Copy to .env.local and fill in from Supabase → Project Settings → API (or "API Keys").
# Leave all three blank to use the in-memory store (local testing only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The public "anon" key (legacy) or "publishable" key (sb_publishable_...). Safe for browsers.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key (legacy) or a "secret" key (sb_secret_...). Server only — never expose this.
SUPABASE_SERVICE_ROLE_KEY=
